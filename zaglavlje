#ifndef NAVIKE_H
#define NAVIKE_H


#define MAX_NAZIV 50
#define DATOTEKA_TXT "navike.txt"
#define DATOTEKA_BIN "navike.bin"


extern int g_ukupnoOperacija;


typedef union {
	int brojDana;
	float satiUlozeno; // [Pravilo 2] Primitivni tipovi s cjelobrojnim i realnim konstantama
} ProgresPodatak;

typedef struct {
	int id;
	char naziv[MAX_NAZIV];
	int ponavljanja;
	ProgresPodatak progres; // Integrirana unija unutar strukture
} Navika;



void kreirajNaviku(Navika** niz, int* brojac, int* kapacitet); // CREATE
void prikaziNavike(const Navika* const niz, const int brojac); // READ
void azurirajNaviku(Navika* const niz, const int brojac); // UPDATE
void obrisiNaviku(Navika* niz, int* brojac); // DELETE


void spremiUdatoteku(const Navika* const niz, const int brojac);
void ucitajIzDatoteke(Navika** niz, int* brojac, int* kapacitet);
void sortirajNavike(Navika* const niz, const int brojac);
void pretraziNaviku(const Navika* const niz, const int brojac);
void pokreniKopiranjeDatoteke(void);


void rekurzivniQuickSort(Navika* niz, int niski, int visoki);

// [Pravilo 9] Ako su funkcije jednostavne koristiti makro funkcije ili inline funkcije
static inline void ispisPozdrava(void) {
	printf("\nHvala sto koristite Tracker Navika!\n");
}

#endif
