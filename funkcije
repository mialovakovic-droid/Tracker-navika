#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>  
#include "navike.h"



static int s_lokalniBrojacPoziva = 0;


int g_ukupnoOperacija = 0;


void sigurnoObrisi(void** pokazivac) {
	if (pokazivac != NULL && *pokazivac != NULL) {
		free(*pokazivac);
		*pokazivac = NULL;
	}
}


void kreirajNaviku(Navika** niz, int* brojac, int* kapacitet) {
	s_lokalniBrojacPoziva++;
	g_ukupnoOperacija++;


	
	if (*brojac >= *kapacitet) {
		*kapacitet *= 2;
		Navika* privremeni = (Navika*)realloc(*niz, *kapacitet * sizeof(Navika));
		if (privremeni == NULL) {
			// [Pravilo 22] Upravljanje pogreškama pomoću perror
			perror("Greska prilikom realokacije memorije");
			return;
		}
		*niz = privremeni;
	}

	printf("\n--- Nova Navika (Create) ---\n");
	(*niz)[*brojac].id = *brojac + 1;

	printf("Unesite naziv navike: ");
	scanf(" %[^\n]", (*niz)[*brojac].naziv);

	printf("Unesite trenutni broj ponavljanja: ");
	scanf("%d", &((*niz)[*brojac].ponavljanja));

	printf("Unesite progres u danima (cijeli broj): ");
	scanf("%d", &((*niz)[*brojac].progres.brojDana));

	(*brojac)++;
	printf("Navika uspjesno dodana u memoriju!\n");
}



void prikaziNavike(const Navika* const niz, const int brojac) {
	g_ukupnoOperacija++;
	printf("\n--- Popis Navika (Read) ---\n");
	if (brojac == 0) {
		printf("Nema dostupnih navika.\n");
		return;
	}
	
	char formatiraniIspis[100];

	for (int i = 0; i < brojac; i++) {
		sprintf(formatiraniIspis, "ID: %d | Naziv: %s | Ponavljanja: %d | Dani: %d",
			niz[i].id, niz[i].naziv, niz[i].ponavljanja, niz[i].progres.brojDana);
		printf("%s\n", formatiraniIspis);
	}
}


void azurirajNaviku(Navika* const niz, const int brojac) {
	g_ukupnoOperacija++;
	int trazeniId;
	printf("\n--- Azuriraj Naviku (Update) ---\n");
	printf("Unesite ID navike za izmjenu: ");
	scanf("%d", &trazeniId);

	for (int i = 0; i < brojac; i++) {
		if (niz[i].id == trazeniId) {
			printf("Unesite novi naziv za '%s': ", niz[i].naziv);
			scanf(" %[^\n]", niz[i].naziv);
			printf("Navika uspjesno azurirana!\n");
			return;
		}
	}
	printf("Navika s tim ID-jem nije pronadena.\n");
}



void obrisiNaviku(Navika* niz, int* brojac) {
	g_ukupnoOperacija++;
	int trazeniId;
	printf("\n--- Obrisi Naviku (Delete) ---\n");
	printf("Unesite ID navike za brisanje: ");
	scanf("%d", &trazeniId);

	for (int i = 0; i < *brojac; i++) {
		if (niz[i].id == trazeniId) {
			for (int j = i; j < *brojac - 1; j++) {
				niz[j] = niz[j + 1];
			}
			(*brojac)--;
			
			spremiUdatoteku(niz, *brojac);
			return;
		}
	}
	printf("Navika s tim ID-jem nije pronadena.\n");
}


void spremiUdatoteku(const Navika* const niz, const int brojac) {
	FILE* fTxt = fopen(DATOTEKA_TXT, "w");
	FILE* fBin = fopen(DATOTEKA_BIN, "wb");

	if (fTxt == NULL || fBin == NULL) {
		perror("Greska pri otvaranju datoteka za pisanje");
		if (fTxt) fclose(fTxt);
		if (fBin) fclose(fBin);
		return;
	}

	for (int i = 0; i < brojac; i++) {
		fprintf(fTxt, "ID:%d, Naziv navike:%s , Broj Ponavljanja: %d, Progres u danu: %d\n", niz[i].id, niz[i].naziv, niz[i].ponavljanja, niz[i].progres.brojDana);
	}


	
	fwrite(niz, sizeof(Navika), brojac, fBin);

	fclose(fTxt);
	fclose(fBin);
	printf("Podaci uspjesno spremljeni u tekstualnu (%s) i binarnu (%s) datoteku!\n", DATOTEKA_TXT, DATOTEKA_BIN);
}

void ucitajIzDatoteke(Navika** niz, int* brojac, int* kapacitet) {
	FILE* fBin = fopen(DATOTEKA_BIN, "rb");
	if (fBin == NULL) {
		
		return;
	}

	
	fseek(fBin, 0, SEEK_END);
	long velicinaDatoteke = ftell(fBin);
	rewind(fBin);

	int brojZapisa = velicinaDatoteke / sizeof(Navika);

	if (brojZapisa > *kapacitet) {
		*kapacitet = brojZapisa + 5;
		Navika* privremeni = (Navika*)realloc(*niz, *kapacitet * sizeof(Navika));
		if (privremeni == NULL) {
			perror("Greska pri reallocu tijekom ucitavanja");
			fclose(fBin);
			return;
		}
		*niz = privremeni;
	}


	
	fread(*niz, sizeof(Navika), brojZapisa, fBin);
	if (ferror(fBin)) {
		printf("Dogodila se pogreska pri citanju binarne datoteke.\n");
	}

	*brojac = brojZapisa;
	fclose(fBin);
	printf("Uspjesno ucitano %d navika iz binarne datoteke.\n", *brojac);
}


void pokreniKopiranjeDatoteke(void) {
	FILE* izvor = fopen(DATOTEKA_TXT, "r");
	FILE* odrediste = fopen("navike_kopija.txt", "w");

	if (izvor == NULL || odrediste == NULL) {
		if (izvor) fclose(izvor);
		if (odrediste) fclose(odrediste);
		return;
	}

	char znak;
	while ((znak = fgetc(izvor)) != EOF) {
		fputc(znak, odrediste);
	}

	fclose(izvor);
	fclose(odrediste);


	
	remove("navike_stara_kopija.txt");
	rename("navike_kopija.txt", "navike_stara_kopija.txt");
	printf("Kopiranje i preimenovanje datoteka izvrseno.\n");
}


void rekurzivniQuickSort(Navika* niz, int niski, int visoki) {
	if (niski < visoki) {
		int pivot = niz[visoki].id;
		int i = (niski - 1);

		for (int j = niski; j <= visoki - 1; j++) {
			if (niz[j].id < pivot) {
				i++;
				Navika temp = niz[i];
				niz[i] = niz[j];
				niz[j] = temp;
			}
		}
		Navika temp = niz[i + 1];
		niz[i + 1] = niz[visoki];
		niz[visoki] = temp;

		int indeksPivota = i + 1;

		rekurzivniQuickSort(niz, niski, indeksPivota - 1);
		rekurzivniQuickSort(niz, indeksPivota + 1, visoki);
	}
}



int usporediPoNazivu(const void* a, const void* b) {
	return strcmp(((Navika*)a)->naziv, ((Navika*)b)->naziv);
}

void sortirajNavike(Navika* const niz, const int brojac) {
	if (brojac < 2) return;
	qsort(niz, brojac, sizeof(Navika), usporediPoNazivu);
	printf("Navike sortirane abecedno po nazivu putem qsort funkcije.\n");
}


int usporediZaPretragu(const void* kljuc, const void* element) {
	return strcmp((char*)kljuc, ((Navika*)element)->naziv);
}

void pretraziNaviku(const Navika* const niz, const int brojac) {
	char trazeniNaziv[MAX_NAZIV];
	printf("Unesite tocan naziv navike za pretragu: ");
	scanf(" %[^\n]", trazeniNaziv);

	
	Navika* pronadeno = (Navika*)bsearch(trazeniNaziv, niz, brojac, sizeof(Navika), usporediZaPretragu);

	if (pronadeno != NULL) {
		printf("Pronadeno! ID: %d | Naziv: %s | Ponavljanja: %d\n", pronadeno->id, pronadeno->naziv, pronadeno->ponavljanja);
	}
	else {
		printf("Navika s nazivom '%s' nije pronadena (Napomena: Niz mora biti sortiran).\n", trazeniNaziv);
	}
}
