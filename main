#define _CRT_SECURE_NO_WARNINGS

#include <stdio.h>
#include <stdlib.h>
#include "navike.h"

//[Pravilo 7] Organizacija izvornog koda kroz jasnu strukturu main funkcije
//[Pravilo 10] Izbornik / podizbornici

int main(void) {
	int pocetniKapacitet = 2;
	//Dinamicki alociran niz na samom pocetku

	Navika* popisNavika = (Navika*)malloc(pocetniKapacitet * sizeof(Navika));
	int brojNavika = 0;

	if (popisNavika == NULL) {
		perror("Nemoguce alocirati pocetnu memoriju");
		return 1;
	}

	//Ucitavanje postojecih podataka na startu aplikacije
	ucitajIzDatoteke(&popisNavika, &brojNavika, &pocetniKapacitet);

	int izbor;
	do {
		printf("\n==== TRACKER NAVIKA ====\n");
		printf("1. Dodaj novu naviku\n");
		printf("2. Prikazi sve navike\n");
		printf("3. Azuriraj postojecu naviku\n");
		printf("4. Obrisi naviku\n");
		printf("5. Sortiraj navike abecedno\n");
		printf("6. Sortiraj navike po ID-ju\n");
		printf("7.Pretrazi naviku po nazivu\n");
		printf("8. Spremi trenutno stanje u datoteke\n");
		printf("9. Kopiraj tekstualnu datoteku\n");
		printf("10. Izlaz iz aplikacije\n");
		printf("------------------------------\n");
		printf("Ukupno izvrsenih operacija: %d\n", g_ukupnoOperacija);
		printf("Izbor: ");
	
		if (scanf("%d", &izbor) != 1) {
			printf("Nevazeci unos. Prekid.\n");
			break;
		}

		switch (izbor) {
			case 1:
				kreirajNaviku(&popisNavika, &brojNavika, &pocetniKapacitet);
				break;
			case 2:
				prikaziNavike(popisNavika, brojNavika);
				break;
			case 3:
				azurirajNaviku(popisNavika, brojNavika);
				break;
			case 4:
				obrisiNaviku(popisNavika, &brojNavika);
				break;
			case 5:
				sortirajNavike(popisNavika, brojNavika);
				break;
			case 6:
				rekurzivniQuickSort(popisNavika, 0, brojNavika - 1);
				printf("Niz je sortiran rekurzuivnim QuickSort algoritmom po ID-ju.\n");
				break;
			case 7:
				pretraziNaviku(popisNavika, brojNavika);
				break;
			case 8:
				spremiUdatoteku(popisNavika, brojNavika);
				break;
			case 9:
				pokreniKopiranjeDatoteke();
				break;
			case 10:
				//Poziv inline funkcije na kraju
				ispisPozdrava();
				break;
			default:
				printf("Pogresan izbor, pokusajte ponovo.\n");
		}

	} while (izbor != 10);

	//[Pravilo 18] Eksterni poziv funkcije za potpuno ciscenje memorije prije samog izlaza

	extern void sigurnoObrisi(void** pokazivac);
	sigurnoObrisi((void**)&popisNavika);

	return 0;
	
}
